# Allow only reviewed source files. Local saves, APKs and generated game code
# remain excluded even if they are accidentally copied beside the project.
*
!.gitignore
!README.md
!LICENSE
!PROVENANCE.md
!requirements.txt
!CMakeLists.txt
!bsm_*.cpp
!bsm_*.h
!bsm_loop.inc
!launch_local.ps1
!project_paths.py
!add_entries.py
!repair_padding_stubs.py
!recover_callbacks.py
!relift_functions.py
!limit_optimizer.py
!install_cursor_hook.py
!install_config_hook.py
!docs/
!docs/*.md
!tools/
!tools/project.py
!tools/engine_110_entries.json
!tests/
!tests/*.cpp
!tests/CMakeLists.txt
!vendor/
!vendor/androidrecomp/
!vendor/androidrecomp/LICENSE
!vendor/androidrecomp/CMakeLists.txt
!vendor/androidrecomp/README.md
!vendor/androidrecomp/runtime/
!vendor/androidrecomp/runtime/*.cpp
!vendor/androidrecomp/runtime/*.h
!vendor/androidrecomp/runtime/*.c
!vendor/androidrecomp/tools/
!vendor/androidrecomp/tools/lifter.py
!vendor/androidrecomp/tools/arc_boot.cpp
!vendor/androidrecomp/tools/arc_host.cpp
!vendor/bionic_random/
!vendor/bionic_random/LICENSE
!vendor/minimp3/
!vendor/minimp3/*.h
**/__pycache__/
**/LocalTestBuild/
**/SaveData/
**/*.save
**/*.apk
**/*.apkm
**/*.so
**/*.swf
**/*.exe
**/*.dll
**/*.zip
